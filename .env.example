# ==============================================================================
# PHARMA CRM - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and replace placeholders with your actual keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# PostgreSQL Database URL
# Local: postgresql://username@localhost:5432/pharma_crm_dev?schema=public
# Production / Supabase / Neon: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/pharma_crm?schema=public"

# JWT Secret for Session Authentication (Generate using: `openssl rand -base64 32`)
JWT_SECRET="dev-only-secret-change-me-in-production-1a2b3c4d5e6f"

# Node Environment ('development' or 'production')
NODE_ENV="development"

# Server Port (Default: 3000)
PORT=3000

# Base Public App URL (Used for webhooks & callbacks)
NEXT_PUBLIC_APP_URL="https://allota.vercel.app"


# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (PRIMARY ENGINE FOR CALL TRANSCRIPTS & HINGLISH SUMMARIES)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
# Free tier gives 1,500 calls/day at ₹0.00 cost!
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_from_google_ai_studio"
GEMINI_MODEL="gemini-2.5-flash"
# Optional: Set a separate free Gemini key for the chatbot so it doesn't share daily quota with call audio transcriptions
GEMINI_CHAT_API_KEY="optional_separate_gemini_api_key_for_chatbot"


# ------------------------------------------------------------------------------
# 3. TWILIO TELEPHONY (OPTIONAL / CLOUD CALLING & BRIDGING)
# Obtain from Twilio Console: https://console.twilio.com/
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"


# ------------------------------------------------------------------------------
# 4. DEEPGRAM SPEECH-TO-TEXT (OPTIONAL ALTERNATIVE)
# Obtain from Deepgram Console: https://console.deepgram.com/
# ------------------------------------------------------------------------------
DEEPGRAM_API_KEY="your_deepgram_api_key"
DEEPGRAM_PROJECT_ID="your_deepgram_project_id"


# ------------------------------------------------------------------------------
# 5. GROQ WHISPER & LLM (OPTIONAL ALTERNATIVE)
# Obtain from Groq Console: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY="your_groq_api_key"
GROQ_WHISPER_MODEL="whisper-large-v3-turbo"


# ------------------------------------------------------------------------------
# 6. WHATSAPP / META CLOUD API (FOR AUTOMATED WHATSAPP ALERTS & NOTIFICATIONS)
# Obtain from Meta Business Suite / Developers: https://developers.facebook.com/
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_waba_account_id"
