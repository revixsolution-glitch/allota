# =======================================================
# Pharma CRM Production Environment Configuration
# =======================================================

# PostgreSQL Database Connection String
# For local / Docker: postgresql://postgres:password@localhost:5432/pharma_crm?schema=public
# For Supabase / RDS / Railway / Neon: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/pharma_crm_prod?schema=public"

# JWT Secret for Session Authentication (Generate a strong 32+ char key using: `openssl rand -base64 32`)
JWT_SECRET="replace-with-a-random-32-byte-hex-or-base64-secret"

# Node Environment ('production' enables secure HTTPS cookie flags)
NODE_ENV="production"

# Port (Default: 3000)
PORT=3000

# Optional: Initial Admin Seed Password (default: admin123)
# ADMIN_DEFAULT_PASSWORD="YourStrongAdminPassword2026!"
